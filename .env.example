# ──────────────────────────────────────────────────────────
# LinyaShare - Environment Variables
# Copy this file to .env and adjust values
# ──────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────
# Default: SQLite (no external database server needed).
# DATABASE_PROVIDER chooses the Prisma schema used by deploy
# scripts (Pterodactyl egg). The runtime app itself only reads
# DATABASE_URL.
#   "sqlite"  → file-based, nothing else to configure
#   "mysql"   → external MySQL / MariaDB server
#   "postgres"→ external PostgreSQL server
# DATABASE_PROVIDER="sqlite"

# SQLite connection string (relative paths resolve from prisma/)
DATABASE_URL="file:./linyashare.db"

# ── External database (optional, replaces SQLite) ────────
# Set DATABASE_PROVIDER AND provide a connection string
# (the database must already exist, tables are created via
# "prisma db push" on deployment):
#
#   MySQL / MariaDB:
#     DATABASE_PROVIDER="mysql"
#     DATABASE_URL="mysql://user:password@dbhost:3306/linyashare"
#
#   PostgreSQL:
#     DATABASE_PROVIDER="postgres"
#     DATABASE_URL="postgresql://user:password@dbhost:5432/linyashare"
#
# Optional: append query params for SSL, e.g.
#   mysql://user:password@dbhost:3306/linyashare?sslmode=prefer
#   postgresql://user:password@dbhost:5432/linyashare?sslmode=require

# Authentication - Required! Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Public URL (used for share links, embeds, OG images)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage paths (relative to project root or absolute paths)
UPLOAD_DIR="data/uploads"
IMPORT_DIR="data/import"
# Global (app-managed) uploads – used for background image and fonts
GLOBAL_UPLOAD_DIR="data/uploads/global"

AUTH_TRUST_HOST=true