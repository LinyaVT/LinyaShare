generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("USER")
  maxSize   Float    @default(524288000)
  files     File[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id            String   @id @default(cuid())
  name          String
  originalName  String
  type          String
  size          Float
  password      String?
  plainPassword String?
  shareId       String   @unique
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  downloads     Int      @default(0)
  status        String   @default("ACTIVE") // "IMPORT" | "ACTIVE"
  embedUrl      String?
  isMediaEmbed  Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}